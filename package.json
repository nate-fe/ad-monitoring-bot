{
  "name": "ad-monitoring-bot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "preinstall": "node ./scripts/check-node.cjs",
    "dev": "node ./scripts/check-node.cjs && vite",
    "build": "node ./scripts/check-node.cjs && vite build",
    "monitor": "node ./scripts/check-node.cjs && node ./monitor.js",
    "monitor:news": "node ./scripts/check-node.cjs && node ./scripts/run-monitor-target.js news",
    "monitor:pann": "node ./scripts/check-node.cjs && node ./scripts/run-monitor-target.js pann",
    "monitor:all": "node ./scripts/check-node.cjs && node ./scripts/run-monitor-all.js",
    "history:update": "node ./scripts/check-node.cjs && node ./scripts/update-history.js",
    "history:update:news": "node ./scripts/check-node.cjs && node ./scripts/run-history-target.js news",
    "history:update:pann": "node ./scripts/check-node.cjs && node ./scripts/run-history-target.js pann",
    "history:update:all": "node ./scripts/check-node.cjs && node ./scripts/run-history-all.js",
    "preview": "node ./scripts/check-node.cjs && vite preview",
    "test:local": "npm run monitor:all && npm run dev"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "^1.58.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
