MONITOR_TARGET_URL_NEWS_VIEW=https://m.news.nate.com/view/20260223n02867
MONITOR_TARGET_URL_NEWS_HOME=https://m.news.nate.com/
MONITOR_TARGET_URL_PANN_VIEW=https://m.pann.nate.com/talk/375312093
MONITOR_TARGET_URL_PANN_HOME=https://m.pann.nate.com/

# 단일 타깃만 수동 실행하고 싶을 때만 사용
# MONITOR_TARGET_URL=https://m.news.nate.com/view/20260223n02867
# MONITOR_TARGET_SCOPE=news

# 선택: 히스토리 원격 소스가 타깃별로 다를 경우
# HISTORY_SOURCE_URL_NEWS_VIEW=
# HISTORY_SOURCE_URL_NEWS_HOME=
# HISTORY_SOURCE_URL_PANN_VIEW=
# HISTORY_SOURCE_URL_PANN_HOME=

# Browser-based checks (Playwright)
# MONITOR_FAIL_ON_PAGEERROR=true
# MONITOR_FAIL_ON_CONSOLE_ERROR=true
# MONITOR_FAIL_ON_REQUEST_FAILED=false
# 기본적으로 GL Driver Message / GPU stall / ReadPixels는 자동 무시됩니다.
# MONITOR_IGNORE_ERROR_PATTERNS=ERR_BLOCKED_BY_CLIENT,net::ERR_FAILED
# MONITOR_NAV_TIMEOUT_MS=30000
# MONITOR_TIMEOUT_MS=45000
# MONITOR_WAIT_AFTER_LOAD_MS=1500
